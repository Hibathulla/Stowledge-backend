enum Role {
  ADMIN
  VIEWER
  DRIVER
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique 
  name         String   
  password     String
  photo        String?
  createdAt    DateTime @default(now())
  role         Role     @default(VIEWER)
  active      Boolean  @default(true)
  passwordResetToken String?  @unique
  passwordResetExpires DateTime?
}